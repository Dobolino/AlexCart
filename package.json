{
  "name": "alexshop",
  "version": "1.0.0",
  "description": "AlexShop \u2013 Einkaufslisten-PWA f\u00fcr iPhone",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:splash": "node scripts/generate-splash.mjs",
    "publish:pages": "npm run build && node scripts/publish-legacy-pages.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src server",
    "server": "node --use-env-proxy --experimental-strip-types server/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "test:e2e": "playwright test",
    "backup:server": "node --experimental-strip-types server/backup.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "decimal.js": "^10.6.0",
    "dexie": "^4.4.7",
    "framer-motion": "^12.42.2",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "tesseract.js": "^5.1.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.14"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
